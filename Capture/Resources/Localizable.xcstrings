      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "PNG (haute qualité)"
          }
        }
      }
    },
    "Plug your iPhone into this Mac with a USB cable to preview its screen, take screenshots and record videos.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Branchez votre iPhone à ce Mac avec un câble USB pour prévisualiser son écran, prendre des captures et enregistrer des vidéos."
          }
        }
      }
    },
    "Preview": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperçu"
          }
        }
      }
    },
    "Recent Captures": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Captures récentes"
          }
        }
      }
    },
    "Recents": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Récents"
