{
  "sourceLanguage": "en",
  "strings": {
    "9:41, full battery and full signal, automatically.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "9:41, batterie pleine et réseau au maximum, automatiquement."
          }
        }
      }
    },
    "A Perfect Status Bar": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une barre d’état parfaite"
          }
        }
      }
    },
    "Access granted": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accès autorisé"
          }
        }
      }
    },
    "Access was denied. You can turn it on in System Settings > Privacy & Security > Camera.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accès a été refusé. Vous pouvez l’activer dans Réglages Système > Confidentialité et sécurité > Caméra."
          }
        }
      }
    },
    "Add an iPhone frame to your captures when you edit them.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez un cadre d’iPhone à vos captures lors de l’édition."
          }
        }
      }
    },
    "Allow Access": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autoriser l’accès"
          }
        }
      }
    },
    "Allow Camera Access": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez l’accès à la caméra"
          }
        }
      }
    },
    "Automatic": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
