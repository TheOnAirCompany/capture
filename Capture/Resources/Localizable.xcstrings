        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Captures d’écran"
          }
        }
      }
    },
    "Screenshots and videos are saved in this folder.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les captures d’écran et vidéos sont enregistrées dans ce dossier."
          }
        }
      }
    },
    "Screenshots you take will appear here.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos captures d’écran apparaîtront ici."
          }
        }
      }
    },
    "See All": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout voir"
          }
        }
      }
    },
    "Settings": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réglages"
          }
        }
      }
    },
    "Shadow": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ombre"
          }
        }
      }
    },
    "Show in Finder": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher dans le Finder"
          }
        }
      }
    },
    "Silver": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Argent"
          }
        }
      }
    },
    "Status Bar": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Barre d’état"
          }
        }
      }
    },
    "Stop Recording": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrêter l’enregistrement"
          }
        }
      }
    },
    "Take Screenshot": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prendre une capture d’écran"
          }
        }
      }
    },
    "Take pixel-perfect screenshots and screen recordings of your iPhone, with the clean 9:41 status bar Apple uses in its own product shots.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réalisez des captures d’écran et des vidéos impeccables de votre iPhone, avec la barre d’état épurée à 9:41 qu’Apple utilise dans ses propres visuels."
          }
        }
      }
    },
    "The file could not be written.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier n’a pas pu être enregistré."
          }
        }
      }
    },
    "Try unplugging your iPhone and plugging it back in.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Essayez de débrancher puis de rebrancher votre iPhone."
          }
        }
      }
    },
    "Unlock your iPhone and tap Trust when asked.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déverrouillez votre iPhone et touchez « Se fier » si on vous le demande."
          }
        }
      }
    },
    "Use a data cable: some cables can only charge.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez un câble de données : certains câbles ne font que charger."
          }
        }
      }
    },
    "Videos": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vidéos"
          }
        }
      }
    },
    "Welcome to Capture": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bienvenue dans Capture"
          }
        }
      }
    },
    "While Capture displays your iPhone, iOS switches its status bar to demo mode: 9:41, full battery and full signal.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pendant que Capture affiche votre iPhone, iOS passe sa barre d’état en mode démo : 9:41, batterie pleine et réseau au maximum."
          }
        }
      }
    },
    "Your captures never leave your Mac.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos captures ne quittent jamais votre Mac."
          }
        }
      }
    },
    "Your iPhone doesn't appear?": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre iPhone n’apparaît pas ?"
          }
        }
      }
    },
    "Your screenshots and videos look clean and consistent, like Apple's own product shots, whatever the real time or battery level. No retouching needed, and nothing personal shows up in the status bar.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos captures et vidéos sont propres et homogènes, comme les visuels d’Apple, quels que soient l’heure réelle ou le niveau de batterie. Aucune retouche nécessaire, et rien de personnel n’apparaît dans la barre d’état."
          }
        }
      }
    },
    "Your screenshots and videos will be saved in this folder.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos captures d’écran et vidéos seront enregistrées dans ce dossier."
          }
        }
      }
    },
    "edited": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "modifiée"
          }
        }
      }
    },
    "iOS controls this mode: it turns on when Capture starts displaying your iPhone and turns off when you disconnect it. It can't be turned off from the Mac.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce mode est géré par iOS : il s’active quand Capture commence à afficher votre iPhone et se désactive quand vous le débranchez. Il ne peut pas être désactivé depuis le Mac."
          }
        }
      }
    },
    "macOS treats your iPhone's screen like a camera. Capture needs this access to display and record it.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS considère l’écran de votre iPhone comme une caméra. Capture a besoin de cet accès pour l’afficher et l’enregistrer."
          }
        }
      }
    }
  },
  "version": "1.0"
}
