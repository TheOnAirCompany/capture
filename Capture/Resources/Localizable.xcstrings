{
  "sourceLanguage": "en",
  "strings": {
    "9:41, full battery and full signal. Automatically, with no notifications.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "9:41, batterie pleine et réseau au maximum. Automatiquement, sans notifications."
          }
        }
      }
    },
    "A Perfect Status Bar": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une barre d’état parfaite"
          }
        }
      }
    },
    "Access granted": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accès autorisé"
          }
        }
      }
    },
    "Access was denied. You can turn it on in System Settings > Privacy & Security > Camera.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accès a été refusé. Vous pouvez l’activer dans Réglages Système > Confidentialité et sécurité > Caméra."
          }
        }
      }
    },
    "Add an iPhone frame to your captures when you edit them.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez un cadre d’iPhone à vos captures lors de l’édition."
          }
        }
      }
    },
    "Allow Access": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autoriser l’accès"
          }
        }
      }
    },
    "Allow Camera Access": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez l’accès à la caméra"
          }
        }
      }
    },
    "Back": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retour"
          }
        }
      }
    },
    "Built for clean iPhone captures": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pensé pour des captures iPhone impeccables"
          }
        }
      }
    },
    "Camera Access Required": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accès à la caméra requis"
          }
        }
      }
    },
    "Capture": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture"
          }
        }
      }
    },
    "Capture can't access this folder. Choose another one, or allow access in System Settings > Privacy & Security > Files and Folders.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture ne peut pas accéder à ce dossier. Choisissez-en un autre, ou autorisez l’accès dans Réglages Système > Confidentialité et sécurité > Fichiers et dossiers."
          }
        }
      }
    },
    "Capture needs camera access to display your iPhone's screen.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture a besoin de l’accès à la caméra pour afficher l’écran de votre iPhone."
          }
        }
      }
    },
    "Capture your iPhone screen in one click, at full native resolution.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Capturez l’écran de votre iPhone en un clic, en pleine résolution."
          }
        }
      }
    },
    "Change…": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifier…"
          }
        }
      }
    },
    "Choose": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisir"
          }
        }
      }
    },
    "Choose Where to Save": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez où enregistrer"
          }
        }
      }
    },
    "Choose where to save your screenshots and videos.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez où enregistrer vos captures d’écran et vidéos."
          }
        }
      }
    },
    "Connect an iPhone to get started.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez un iPhone pour commencer."
          }
        }
      }
    },
    "Connect your iPhone": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez votre iPhone"
          }
        }
      }
    },
    "Connected": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecté"
          }
        }
      }
    },
    "Continue": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuer"
          }
        }
      }
    },
    "Couldn't Save the Capture": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’enregistrer la capture"
          }
        }
      }
    },
    "Device Frames": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cadres d’appareil"
          }
        }
      }
    },
    "Everything QuickTime does, only faster and more powerful.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout ce que fait QuickTime, en plus pratique et plus complet."
          }
        }
      }
    },
    "Find all your captures in one place.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retrouvez toutes vos captures au même endroit."
          }
        }
      }
    },
    "Get Started": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commencer"
          }
        }
      }
    },
    "Need Help?": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Besoin d’aide ?"
          }
        }
      }
    },
    "No Device": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun appareil"
          }
        }
      }
    },
    "No Screenshots Yet": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune capture d’écran"
          }
        }
      }
    },
    "No Videos Yet": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune vidéo"
          }
        }
      }
    },
    "No image has been received from the iPhone yet.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune image n’a encore été reçue de l’iPhone."
          }
        }
      }
    },
    "OK": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "OK"
          }
        }
      }
    },
    "Open Capture Folder": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrir le dossier Capture"
          }
        }
      }
    },
    "Open System Settings": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrir les Réglages Système"
          }
        }
      }
    },
    "Plug your iPhone into this Mac with a USB cable to preview its screen, take screenshots and record videos.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Branchez votre iPhone à ce Mac avec un câble USB pour prévisualiser son écran, prendre des captures et enregistrer des vidéos."
          }
        }
      }
    },
    "Preview": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperçu"
          }
        }
      }
    },
    "Recents": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Récents"
          }
        }
      }
    },
    "Record Video": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture vidéo"
          }
        }
      }
    },
    "Record videos with sound, straight from your iPhone.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez des vidéos avec le son, directement depuis votre iPhone."
          }
        }
      }
    },
    "Screen Recordings": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture vidéo"
          }
        }
      }
    },
    "Screen recordings you make will appear here.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos enregistrements vidéo apparaîtront ici."
          }
        }
      }
    },
    "Screenshot": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture d’écran"
          }
        }
      }
    },
    "Screenshots": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Captures d’écran"
          }
        }
      }
    },
    "Screenshots you take will appear here.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos captures d’écran apparaîtront ici."
          }
        }
      }
    },
    "Stop Recording": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrêter l’enregistrement"
          }
        }
      }
    },
    "Take Screenshot": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prendre une capture d’écran"
          }
        }
      }
    },
    "Take pixel-perfect screenshots and screen recordings of your iPhone, with the clean 9:41 status bar Apple uses in its own product shots.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réalisez des captures d’écran et des vidéos impeccables de votre iPhone, avec la barre d’état épurée à 9:41 qu’Apple utilise dans ses propres visuels."
          }
        }
      }
    },
    "The file could not be written.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier n’a pas pu être enregistré."
          }
        }
      }
    },
    "Try unplugging your iPhone and plugging it back in.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Essayez de débrancher puis de rebrancher votre iPhone."
          }
        }
      }
    },
    "Unlock your iPhone and tap Trust when asked.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déverrouillez votre iPhone et touchez « Se fier » si on vous le demande."
          }
        }
      }
    },
    "Use a data cable: some cables can only charge.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez un câble de données : certains câbles ne font que charger."
          }
        }
      }
    },
    "Videos": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vidéos"
          }
        }
      }
    },
    "Welcome to Capture": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bienvenue dans Capture"
          }
        }
      }
    },
    "Your captures never leave your Mac.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos captures ne quittent jamais votre Mac."
          }
        }
      }
    },
    "Your iPhone doesn't appear?": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre iPhone n’apparaît pas ?"
          }
        }
      }
    },
    "Your screenshots and videos will be saved in this folder.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos captures d’écran et vidéos seront enregistrées dans ce dossier."
          }
        }
      }
    },
    "macOS treats your iPhone's screen like a camera. Capture needs this access to display and record it.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS considère l’écran de votre iPhone comme une caméra. Capture a besoin de cet accès pour l’afficher et l’enregistrer."
          }
        }
      }
    }
  },
  "version": "1.0"
}
