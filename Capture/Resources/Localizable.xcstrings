      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Emplacement d’enregistrement"
          }
        }
      }
    },
    "Screen Recordings": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture vidéo"
          }
        }
      }
    },
    "Screen recordings you make will appear here.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos enregistrements vidéo apparaîtront ici."
          }
        }
      }
    },
